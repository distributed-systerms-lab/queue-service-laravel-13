# Local lab only. Choose URI-safe passwords, e.g. openssl rand -hex 24.
RABBITMQ_USER=lab
RABBITMQ_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PASSWORD=replace-with-another-random-hex-password

LAB_NETWORK=lab-messaging
QUEUES=tasks
QUEUE_NAME=tasks
CONCURRENCY=4
MAX_RETRIES=3
MAX_QUEUE_LENGTH=100000
# Each API worker is a PHP/Laravel process: tune its memory budget too.
PUBLISH_CONCURRENCY=4
OPERATION_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
RETRY_DELAY=1s
PROCESSING_DELAY=0s
ACKNOWLEDGMENT_DELAY=0s

# For development outside Docker, set AMQP_URL and DATABASE_URL explicitly.
# AMQP_URL=amqp://lab:password@127.0.0.1:5672/
# DATABASE_URL=postgres://lab:password@127.0.0.1:5432/queue_lab?sslmode=disable
