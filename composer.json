{
    "name": "distributed-systerms-lab/queue-service-laravel-13",
    "type": "project",
    "description": "Laravel 13 gRPC queue service with confirmed RabbitMQ publishing and idempotent PostgreSQL receipts",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-sockets": "*",
        "google/protobuf": "^4.33",
        "laravel/framework": "^13.17",
        "php-amqplib/php-amqplib": "^3.7",
        "roadrunner/grpc": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Queue\\V1\\": "generated/Queue/V1/",
            "GPBMetadata\\": "generated/GPBMetadata/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit --testsuite Unit",
        "integration": "phpunit --testsuite Integration",
        "lint": "find app bootstrap config routes tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
